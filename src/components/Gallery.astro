---
// A grid of pictures inside a post.
// In an .mdx post:
//   import a from './a.jpg'
//   import b from './b.jpg'
//   <Gallery images={[a, b]} alts={['The desk', 'The view']} />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { images: ImageMetadata[]; alts?: string[] }
const { images, alts = [] } = Astro.props;
---

<div class="gallery">
  {images.map((img, i) => <Image src={img} alt={alts[i] ?? ''} width={900} />)}
</div>
