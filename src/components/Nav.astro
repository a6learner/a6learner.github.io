---
import { site } from '../site.config';
import { t, href, otherLangPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: t(lang, 'nav.writing'), to: href(lang, '/blog') },
  { label: t(lang, 'nav.thoughts'), to: href(lang, '/thoughts') },
  { label: t(lang, 'nav.projects'), to: href(lang, '/projects') },
  { label: t(lang, 'nav.about'), to: href(lang, '/about') },
];
const isCurrent = (to: string) => path === to || path.startsWith(to + '/');
const switchTo = otherLangPath(Astro.url.pathname, lang);
---

<nav class="nav" aria-label="Main">
  <div class="nav__pill">
    <a class="nav__mark" href={href(lang, '/')} aria-label={t(lang, 'nav.home')}>{site.short[lang]}</a>
    <ul class="nav__links nav__links--wide">
      {links.map((l) => (
        <li><a class="nav__link" href={l.to} aria-current={isCurrent(l.to) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <span class="nav__sep" aria-hidden="true"></span>
    <a class="nav__tool" href={switchTo} hreflang={lang === 'en' ? 'zh-CN' : 'en'} aria-label={t(lang, 'nav.switchLabel')} lang={lang === 'en' ? 'zh-CN' : 'en'}>{t(lang, 'nav.switch')}</a>
    <button class="nav__tool" type="button" data-mode-toggle aria-label={t(lang, 'mode.toggle')}>
      <svg class="mode-icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="mode-icon--dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <details class="nav__menu">
      <summary class="nav__tool">{t(lang, 'nav.menu')}</summary>
      <ul class="nav__drop">
        {links.map((l) => (
          <li><a class="nav__link" href={l.to} aria-current={isCurrent(l.to) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </details>
  </div>
</nav>

<script>
  const root = document.documentElement;
  document.querySelector('[data-mode-toggle]')?.addEventListener('click', () => {
    const current = root.dataset.mode ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.mode = next;
    try { localStorage.setItem('mode', next); } catch (e) {}
  });
  // close the small-screen menu when clicking elsewhere or pressing Escape
  const menu = document.querySelector<HTMLDetailsElement>('.nav__menu');
  document.addEventListener('click', (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
</script>
