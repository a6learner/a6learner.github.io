---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FileCard from '../components/FileCard.astro';
import Gallery from '../components/Gallery.astro';
import { readingMinutes, type Item } from '../lib/content';
import { t, href, formatDate, type Lang } from '../i18n/ui';

interface Props { lang: Lang; item: Item<'blog'> }
const { lang, item } = Astro.props;
const { entry } = item;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const written = item.lang === 'zh' ? 'zh-CN' : 'en';
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="post__head container" lang={item.fallback ? written : undefined}>
      <p><a class="textlink" href={href(lang, '/blog')}>{t(lang, 'blog.back')}</a></p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <p class="post__meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
        <span>{t(lang, 'blog.minutes', { n: readingMinutes(entry.body) })}</span>
        {entry.data.tags.length > 0 && (
          <span>{entry.data.tags.map((tag, i) => <>{i > 0 && ', '}<a href={href(lang, `/blog?tag=${encodeURIComponent(tag)}`)}>{tag}</a></>)}</span>
        )}
        {item.isDraft && <span class="badge">{t(lang, 'badge.draft')}</span>}
        {item.isPrivate && <span class="badge">{t(lang, 'badge.private')}</span>}
      </p>
    </header>
    <div class="container">
      {entry.data.cover && (
        <figure class="sheet post__cover" style="--r: -0.6deg">
          <Image src={entry.data.cover} alt="" width={1400} loading="eager" />
        </figure>
      )}
      <div class="post__layout">
        <div class="sheet post__sheet">
          {item.fallback && <p class="notice sheet--fluoro">{t(lang, 'blog.onlyIn')}</p>}
          <div class="prose" lang={item.fallback ? written : undefined}>
            <Content components={{ FileCard, Gallery }} />
          </div>
        </div>
        {toc.length > 1 && (
          <nav class="toc" aria-label={t(lang, 'blog.contents')}>
            <p><strong>{t(lang, 'blog.contents')}</strong></p>
            <ol>
              {toc.map((h) => <li class={`toc--${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )}
      </div>
    </div>
  </article>
</Base>
